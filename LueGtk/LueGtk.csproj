<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LueGtk</RootNamespace>
    <AssemblyName>LueGtk</AssemblyName>
    <Description>Native GTK 4 port of the Lue document editor.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.8.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LueGtk.Tests/**" />
    <None Remove="LueGtk.Tests/**" />
    <Content Remove="LueGtk.Tests/**" />
  </ItemGroup>

  <!-- Copy the welcome document, logo, and theme marker used to find the application root. -->
  <ItemGroup>
    <Content Include="..\themes\**\*.ini" Link="themes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\welcome.lue" Link="welcome.lue" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\logo.png" Link="logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\logo-icon.png" Link="logo-icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fonts\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
